{
  "extends": "./tsconfig.app.json",

  // Include the test surface (colocated `src/**/*.test.ts` and cross-cutting
  // `src/**/__tests__/*`) plus the MSW infrastructure in `test/**/*`; the app
  // project (tsconfig.app.json) excludes tests, so they are type-checked only
  // here. Application code imported by tests is included via module resolution.
  "include": ["src/**/*.test.ts", "src/**/__tests__/*", "test/**/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    "lib": [],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
