    "@vee-validate/zod": "^4.15.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.2",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
